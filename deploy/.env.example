HIGHLIGHT_STUDIO_AUTO_CREATE_DATABASE=0
HIGHLIGHT_STUDIO_WEB_DOMAIN=highlightstudio.example
HIGHLIGHT_STUDIO_API_DOMAIN=api.highlightstudio.example
HIGHLIGHT_STUDIO_CADDY_EMAIL=support@highlightstudio.example

# Generate with: python tools/licensing/generate_keypair.py
HIGHLIGHT_STUDIO_LICENSE_PRIVATE_KEY_B64=REPLACE_WITH_SECRET
HIGHLIGHT_STUDIO_LICENSE_ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
HIGHLIGHT_STUDIO_PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

POSTGRES_DB=highlight_studio
POSTGRES_USER=highlight
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
HIGHLIGHT_STUDIO_ALLOW_REGISTRATION=1
HIGHLIGHT_STUDIO_SESSION_DAYS=30

# Optional if frontend is served from a different origin. Same-origin web deploy leaves it empty.
HIGHLIGHT_STUDIO_ALLOWED_ORIGINS=
HIGHLIGHT_STUDIO_COOKIE_SECURE=1
POSTGRES_BACKUP_RETENTION_DAYS=14
HIGHLIGHT_STUDIO_PUBLIC_BASE_URL=https://highlightstudio.example
HIGHLIGHT_STUDIO_REQUIRE_EMAIL_VERIFICATION=0
HIGHLIGHT_STUDIO_SMTP_HOST=
HIGHLIGHT_STUDIO_SMTP_PORT=587
HIGHLIGHT_STUDIO_SMTP_USER=
HIGHLIGHT_STUDIO_SMTP_PASSWORD=
HIGHLIGHT_STUDIO_SMTP_FROM=noreply@highlightstudio.example
HIGHLIGHT_STUDIO_SMTP_USE_TLS=1
# Set to 1 only after SMTP and PUBLIC_BASE_URL are configured and tested.
HIGHLIGHT_STUDIO_DEV_AUTH_TOKENS=0
